+"""Newline-delimited JSON exporter for widgets (default format, see memory/project_widget_export.md).
+
+Every function here is pure: no I/O, no mutation of inputs. Callers decide
+where the resulting string goes.
+"""
+
+import json
+from typing import Any, Iterable, Mapping, Sequence
+
+from .csv_exporter import COLUMNS
+
+_NEWLINE = "\n"
+
+
+def select_fields(widget: Mapping[str, Any], columns: Sequence[str] = COLUMNS) -> dict[str, Any]:
+    """Project one widget onto the export columns, in column order.
+
+    Missing keys become null, mirroring the empty field in the CSV exporter.
+    """
+    return {column: widget.get(column) for column in columns}
+
+
+def format_record(widget: Mapping[str, Any], columns: Sequence[str] = COLUMNS) -> str:
+    """Render one widget as a single JSON line (json.dumps never emits newlines here).
+
+    Values JSON cannot encode natively (e.g. datetimes) fall back to str(),
+    matching the CSV exporter's rendering.
+    """
+    return json.dumps(select_fields(widget, columns), default=str)
+
+
+def to_json(widgets: Iterable[Mapping[str, Any]], columns: Sequence[str] = COLUMNS) -> str:
+    """Render widgets as newline-delimited JSON: one object per line, each line terminated.
+
+    Empty input yields "" (no lines), the NDJSON analogue of an empty document.
+    """
+    return "".join(format_record(widget, columns) + _NEWLINE for widget in widgets)
+
+
+__all__ = ["COLUMNS", "select_fields", "format_record", "to_json"]
